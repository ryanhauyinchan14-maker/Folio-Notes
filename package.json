{
  "name": "goodnotes",
  "version": "1.4.20",
  "description": "Folio Notes — Local-First Digital Notes",
  "author": "Folio Notes",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "electron:compile": "node scripts/generate-icon.mjs --prepare-electron && tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && npm run electron:compile && electron . --dev\"",
    "electron:build": "npm run build && npm run electron:compile && electron-builder --win && node scripts/write-local-update-manifest.mjs"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@paper-design/shaders-react": "^0.0.82",
    "dexie": "^4.4.7",
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.73.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.folionotes.desktop",
    "productName": "Folio Notes",
    "publish": [
      {
        "provider": "github",
        "owner": "ryanhauyinchan14-maker",
        "repo": "Folio-Notes"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Folio Notes",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "artifactName": "Folio-Notes-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Folio-Notes-Portable-${version}.${ext}"
    }
  }
}
